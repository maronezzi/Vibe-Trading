[Unit]
Description=Gateway Hermes (Telegram/chat) — Vibe-Trading
After=network-online.target

[Service]
Type=simple
User=bruno
Environment=HOME=/home/bruno
ExecStart=/home/bruno/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
Restart=always
RestartSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
